+                    'type' => 'hidden',
+                    'name' => $elementname . '[validate]',
+                    'id' => $elementname . '-validate',
+                    'value' => 0,
+                ]);
+                $editable .= $this->display_rubric($criteria, $options, gradingform_rubric_ranges_controller::DISPLAY_EVAL,
+                    $elementname, $values);
